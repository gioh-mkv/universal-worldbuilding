{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Worldbuilding",
  "version": "0.1.0",
  "identifier": "com.giovanna.uwb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Worldbuilding",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Construtor de universos ficcionais",
    "longDescription": "Aplicativo local-first para criar, documentar e organizar universos ficcionais: entidades personalizadas, documentos com menções, relações e pesquisa.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
